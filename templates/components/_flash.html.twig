{% for label, messages in app.flashes %}
  {% for message in messages %}
    {% set bootstrapLabel = label == 'error' ? 'danger' : label %}
    <div class="alert alert-{{ bootstrapLabel }} alert-dismissible fade show" role="alert">
      {{ message }}
      <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Fermer"></button>
    </div>
  {% endfor %}
{% endfor %}
