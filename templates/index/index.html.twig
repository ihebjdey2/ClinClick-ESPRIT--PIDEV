{% extends 'base.html.twig' %}

{% block title %}Tableau de bord | CliniClic{% endblock %}

{% block body %}
<main id="main" class="main">
  <div class="pagetitle">
    <h1>{{ dashboard.title }}</h1>
    <p class="text-muted">Bonjour {{ app.user.prenom }}, voici les informations utiles pour votre rôle.</p>
  </div>

  <section class="section dashboard">
    <div class="row g-4 mb-4">
      {% for card in dashboard.cards %}
        <div class="col-sm-6 col-xl-3">
          <div class="card h-100"><div class="card-body d-flex align-items-center gap-3 pt-4">
            <div class="profile-avatar" aria-hidden="true"><i class="bi {{ card.icon }}"></i></div>
            <div><div class="fs-3 fw-bold">{{ card.value }}</div><div class="small text-muted">{{ card.label }}</div></div>
          </div></div>
        </div>
      {% endfor %}
    </div>

    <div class="row g-4">
      <div class="col-xl-8">
        <div class="card h-100"><div class="card-body pt-4">
          {% if dashboard.role == 'admin' %}
            <h2 class="card-title pt-0">Confidentialité des données</h2>
            <div class="alert alert-info mb-0" role="status">
              Le tableau de bord administrateur affiche uniquement des indicateurs opérationnels. Les identités et informations médicales des patients ne sont pas exposées ici.
            </div>
          {% else %}
            <div class="d-flex justify-content-between align-items-center gap-3 mb-3">
              <h2 class="card-title pt-0 mb-0">Prochains rendez-vous</h2>
              <a href="{{ path('app_RDV_index') }}" class="btn btn-sm btn-outline-primary">Voir tout</a>
            </div>
            <div class="table-responsive">
              <table class="table table-hover align-middle mb-0">
                <thead><tr><th>Date</th>{% if dashboard.show_patient_identity %}<th>Patient</th>{% endif %}<th>Médecin</th><th>Statut</th></tr></thead>
                <tbody>
                  {% for appointment in dashboard.upcoming %}
                    <tr>
                      <td><strong>{{ appointment.scheduledAt|date('d/m/Y') }}</strong><br><span class="small text-muted">{{ appointment.scheduledAt|date('H:i') }}</span></td>
                      {% if dashboard.show_patient_identity %}<td>{{ appointment.patient.fullName }}</td>{% endif %}
                      <td>Dr {{ appointment.doctor.fullName }}</td>
                      <td><span class="badge {{ appointment.status.badgeClass }}">{{ appointment.status.label }}</span></td>
                    </tr>
                  {% else %}
                    <tr><td colspan="{{ dashboard.show_patient_identity ? 4 : 3 }}" class="text-center text-muted py-5">Aucun rendez-vous à venir.</td></tr>
                  {% endfor %}
                </tbody>
              </table>
            </div>
          {% endif %}
        </div></div>
      </div>

      <div class="col-xl-4">
        <div class="card h-100"><div class="card-body pt-4">
          <h2 class="card-title pt-0">Accès rapides</h2>
          <div class="d-grid gap-2">
            {% if dashboard.role != 'doctor' %}<a class="btn btn-primary" href="{{ path('app_RDV_new') }}"><i class="bi bi-calendar-plus me-2" aria-hidden="true"></i>Nouveau rendez-vous</a>{% endif %}
            <a class="btn btn-outline-primary" href="{{ path('app_RDV_index') }}">Consulter les rendez-vous</a>
            {% if dashboard.role == 'doctor' %}<a class="btn btn-outline-primary" href="{{ path('app_doctor_availability_index') }}">Gérer mes disponibilités</a>{% endif %}
            {% if dashboard.role == 'admin' %}
              <a class="btn btn-outline-primary" href="{{ path('app_admin_user_index') }}">Gérer les utilisateurs</a>
              <a class="btn btn-outline-primary" href="{{ path('display_stock') }}">Consulter le stock</a>
            {% endif %}
            {% if dashboard.role == 'receptionist' %}<a class="btn btn-outline-primary" href="{{ path('app_reclamation') }}">Traiter les réclamations</a>{% endif %}
            <a class="btn btn-outline-secondary" href="{{ path('app_profile') }}">Mettre à jour mon profil</a>
          </div>
        </div></div>
      </div>
    </div>
  </section>
</main>
{% endblock %}
