<main id="main" class="main">
  <div class="pagetitle">
    <h1>{{ title }}</h1>
    <p class="text-muted">Les conflits et disponibilités du médecin sont vérifiés lors de l'enregistrement.</p>
  </div>
  <section class="section">
    <div class="row justify-content-center"><div class="col-xl-8">
      <div class="card"><div class="card-body pt-4">
        {{ form_start(form) }}
          {{ form_errors(form) }}
          <div class="row g-3">
            <div class="col-12">{{ form_row(form.nom) }}</div>
            {% if form.patient is defined %}<div class="col-12">{{ form_row(form.patient) }}</div>{% endif %}
            <div class="col-md-6">{{ form_row(form.doctor) }}</div>
            <div class="col-md-6">{{ form_row(form.category) }}</div>
            <div class="col-md-8">{{ form_row(form.scheduledAt) }}</div>
            <div class="col-md-4">{{ form_row(form.durationMinutes) }}</div>
            <div class="col-12">{{ form_row(form.notes) }}</div>
          </div>
          <div class="d-flex flex-wrap gap-2">
            <button type="submit" class="btn btn-primary">{{ buttonLabel }}</button>
            <a class="btn btn-outline-secondary" href="{{ path('app_RDV_index') }}">Annuler</a>
          </div>
        {{ form_end(form) }}
      </div></div>
    </div></div>
  </section>
</main>
