<!doctype html>
<html lang="fr">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <meta name="description" content="Accès sécurisé à CliniClic">
  <title>{% block title %}CliniClic{% endblock %}</title>
  <link href="{{ asset('assets/img/favicon.png') }}" rel="icon">
  <link href="{{ asset('assets/vendor/bootstrap/css/bootstrap.min.css') }}" rel="stylesheet">
  <link href="{{ asset('assets/vendor/bootstrap-icons/bootstrap-icons.css') }}" rel="stylesheet">
  <style>
    body { background: #f4f8fc; color: #24344d; }
    .auth-shell { min-height: 100vh; }
    .auth-card { border: 0; border-radius: 1rem; box-shadow: 0 1rem 3rem rgba(29, 65, 107, .1); }
    .auth-brand { color: #0d6efd; font-weight: 700; text-decoration: none; }
    .auth-mark { align-items: center; background: #e7f1ff; border-radius: .75rem; display: inline-flex; height: 3rem; justify-content: center; width: 3rem; }
    .form-control:focus, .form-select:focus, .form-check-input:focus { box-shadow: 0 0 0 .25rem rgba(13, 110, 253, .2); }
  </style>
</head>
<body>
  <main class="auth-shell d-flex align-items-center py-5">
    <div class="container">
      <div class="row justify-content-center">
        <div class="col-lg-7 col-xl-5">
          <div class="text-center mb-4">
            <a class="auth-brand fs-3" href="{{ path('appHome') }}"><span class="auth-mark me-2"><i class="bi bi-heart-pulse"></i></span>CliniClic</a>
          </div>
          <div class="card auth-card"><div class="card-body p-4 p-md-5">
            {% block body %}{% endblock %}
          </div></div>
          <p class="text-center small text-muted mt-4">Vos informations restent accessibles uniquement aux personnes autorisées.</p>
        </div>
      </div>
    </div>
  </main>
  <script src="{{ asset('assets/vendor/bootstrap/js/bootstrap.bundle.min.js') }}"></script>
</body>
</html>
