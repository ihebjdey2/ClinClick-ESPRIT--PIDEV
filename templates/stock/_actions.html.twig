<div class="d-inline-flex flex-wrap justify-content-end gap-2">
  <a class="btn btn-sm btn-outline-primary" href="{{ path('modif_stock', {id: stock.id}) }}">Modifier</a>
  <form method="post" action="{{ path('supp_stock', {id: stock.id}) }}" onsubmit="return confirm('Supprimer ce produit du stock ?');">
    <input type="hidden" name="_token" value="{{ csrf_token('delete-stock-' ~ stock.id) }}">
    <button class="btn btn-sm btn-outline-danger" type="submit">Supprimer</button>
  </form>
</div>
