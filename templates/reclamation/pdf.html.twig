<!doctype html>
<html lang="fr">
<head>
  <meta charset="utf-8">
  <title>Réclamations CliniClic</title>
  <style>
    body { color: #24344d; font-family: Arial, sans-serif; font-size: 11px; }
    h1 { color: #0d6efd; font-size: 20px; }
    table { border-collapse: collapse; width: 100%; }
    th, td { border: 1px solid #dce3ec; padding: 7px; text-align: left; vertical-align: top; }
    th { background: #eef5ff; }
  </style>
</head>
<body>
  <h1>Liste des réclamations</h1>
  <table>
    <thead>
      <tr><th>Nom</th><th>E-mail</th><th>Catégorie</th><th>Description</th><th>État</th></tr>
    </thead>
    <tbody>
      {% for complaint in reclamations %}
        <tr>
          <td>{{ complaint.nom }}</td>
          <td>{{ complaint.email }}</td>
          <td>{{ complaint.categorieReclamation }}</td>
          <td>{{ complaint.description }}</td>
          <td>{{ complaint.etat ? 'Traitée' : 'En attente' }}</td>
        </tr>
      {% else %}
        <tr><td colspan="5">Aucune réclamation.</td></tr>
      {% endfor %}
    </tbody>
  </table>
</body>
</html>
