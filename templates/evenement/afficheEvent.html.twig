{% extends 'base_front.html.twig' %}

{% block title %}Événements | CliniClic{% endblock %}

{% block body %}
<section class="page-hero"><div class="container py-5"><span class="eyebrow">Vie de la clinique</span><h1 class="mt-2">Événements à venir</h1><p class="mb-0">Actions de prévention, rencontres et ateliers proposés par la clinique.</p></div></section>
<section class="section-space"><div class="container">
  <div class="row g-4">
    {% for evenement in evenements %}
      {% set participantCount = participant_counts[evenement.id]|default(0) %}
      <div class="col-md-6 col-xl-4"><article class="event-card h-100">
        <img src="{{ evenement.image ? asset('images/' ~ evenement.image) : asset('images/default-event.svg') }}" alt="Illustration de {{ evenement.titre }}">
        <div class="p-4 d-flex flex-column h-100">
          <div class="d-flex justify-content-between align-items-center gap-3"><span class="badge text-bg-light">{{ evenement.category }}</span><time datetime="{{ evenement.date|date('Y-m-d') }}">{{ evenement.date|date('d/m/Y') }}</time></div>
          <h2 class="h4 mt-3">{{ evenement.titre }}</h2><p>{{ evenement.description }}</p>
          <div class="event-capacity mt-auto mb-3"><div class="d-flex justify-content-between small"><span>Places réservées</span><span>{{ participantCount }}/{{ max_participants }}</span></div><div class="progress" role="progressbar" aria-label="Places réservées" aria-valuenow="{{ participantCount }}" aria-valuemin="0" aria-valuemax="{{ max_participants }}"><div class="progress-bar" style="width: {{ (participantCount / max_participants * 100)|round }}%"></div></div></div>
          <div class="d-flex flex-wrap gap-2">
            <a class="btn btn-outline-primary" href="{{ path('app_evenement_show', {id: evenement.id}) }}">Détails</a>
            {% if participantCount < max_participants %}
              {% if app.user %}<form method="post" action="{{ path('app_evenement_participer', {id: evenement.id}) }}"><input type="hidden" name="_token" value="{{ csrf_token('participate-event-' ~ evenement.id) }}"><button class="btn btn-primary" type="submit">Participer</button></form>
              {% else %}<a class="btn btn-primary" href="{{ path('app_login') }}">Se connecter pour participer</a>{% endif %}
            {% else %}<span class="badge text-bg-secondary align-self-center">Complet</span>{% endif %}
          </div>
        </div>
      </article></div>
    {% else %}
      <div class="col-12"><div class="empty-state-public"><i class="bi bi-calendar2" aria-hidden="true"></i><h2 class="h5">Aucun événement programmé</h2><p class="mb-0">Revenez prochainement pour découvrir les nouvelles activités.</p></div></div>
    {% endfor %}
  </div>
</div></section>
{% endblock %}
