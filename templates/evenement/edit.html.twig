{% extends 'base.html.twig' %}
{% block title %}Modifier l’événement | CliniClic{% endblock %}
{% block body %}<main id="main" class="main"><div class="pagetitle"><h1>Modifier l’événement</h1><p class="text-muted mb-0">L’image actuelle est conservée si aucun nouveau fichier n’est sélectionné.</p></div><section class="section"><div class="row justify-content-center"><div class="col-xl-9"><div class="card"><div class="card-body pt-4">{% if evenement.image %}<div class="mb-4"><p class="form-label">Image actuelle</p><img class="rounded border" src="{{ asset('images/' ~ evenement.image) }}" alt="Illustration actuelle" style="max-height: 180px; max-width: 100%; object-fit: cover;"></div>{% endif %}{{ include('evenement/_form.html.twig', {button_label: 'Enregistrer les modifications'}) }}</div></div></div></div></section></main>{% endblock %}
