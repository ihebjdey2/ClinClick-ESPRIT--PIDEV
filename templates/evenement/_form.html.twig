{{ form_start(form) }}
  {{ form_errors(form) }}
  <div class="row g-3">
    <div class="col-md-7">{{ form_row(form.titre) }}</div>
    <div class="col-md-5">{{ form_row(form.category) }}</div>
    <div class="col-12">{{ form_row(form.description) }}</div>
    <div class="col-md-6">{{ form_row(form.date) }}</div>
    <div class="col-md-6">{{ form_row(form.imageFile) }}</div>
  </div>
  <div class="d-flex flex-wrap gap-2 mt-4"><button class="btn btn-primary" type="submit">{{ button_label|default('Enregistrer') }}</button><a class="btn btn-outline-secondary" href="{{ path('app_evenement_indexFront') }}">Annuler</a></div>
{{ form_end(form) }}
