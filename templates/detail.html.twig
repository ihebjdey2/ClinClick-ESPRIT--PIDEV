{% extends 'base_front.html.twig' %}
{% block title %}{{ evenement.titre }} | CliniClic{% endblock %}
{% block body %}
<section class="page-hero"><div class="container py-5"><nav aria-label="Fil d’Ariane"><ol class="breadcrumb"><li class="breadcrumb-item"><a href="{{ path('appHome') }}">Accueil</a></li><li class="breadcrumb-item"><a href="{{ path('app_evenement_index') }}">Événements</a></li><li class="breadcrumb-item active" aria-current="page">Détail</li></ol></nav><h1>{{ evenement.titre }}</h1></div></section>
<section class="section-space"><div class="container"><div class="row justify-content-center"><div class="col-lg-9"><article class="event-card"><img src="{{ evenement.image ? asset('images/' ~ evenement.image) : asset('images/default-event.svg') }}" alt="Illustration de {{ evenement.titre }}"><div class="p-4 p-md-5"><div class="d-flex flex-wrap justify-content-between gap-3"><span class="badge text-bg-light">{{ evenement.category }}</span><time datetime="{{ evenement.date|date('Y-m-d') }}"><i class="bi bi-calendar-event me-1" aria-hidden="true"></i>{{ evenement.date|date('d/m/Y') }}</time></div><p class="lead mt-4 mb-4">{{ evenement.description }}</p><div class="d-flex flex-wrap gap-2"><a class="btn btn-outline-primary" href="{{ path('app_evenement_index') }}">Retour aux événements</a>{% if is_granted('ROLE_ADMIN') %}<a class="btn btn-primary" href="{{ path('app_evenement_edit', {id: evenement.id}) }}">Modifier</a>{% endif %}</div></div></article></div></div></div></section>
{% endblock %}
