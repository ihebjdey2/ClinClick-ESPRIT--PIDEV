{% extends 'base_front.html.twig' %}

{% block title %}CliniClic | La clinique, simplement{% endblock %}
{% block meta_description %}CliniClic centralise rendez-vous, suivi médical et informations de clinique dans des espaces sécurisés par rôle.{% endblock %}

{% block body %}
<section class="hero-section">
  <div class="container py-5">
    <div class="row align-items-center g-4 g-lg-5 py-lg-5">
      <div class="col-lg-6">
        <span class="eyebrow"><i class="bi bi-shield-check" aria-hidden="true"></i> Parcours de soins sécurisé</span>
        <h1 class="display-4 mt-3">Votre clinique, plus claire et plus proche.</h1>
        <p class="lead mt-4">Prenez rendez-vous, suivez vos consultations et retrouvez les informations utiles dans un espace adapté à votre rôle.</p>
        <div class="d-flex flex-wrap gap-3 mt-4">
          {% if app.user %}
            <a class="btn btn-primary btn-lg" href="{{ path('app_RDV_new') }}">Prendre rendez-vous</a>
            <a class="btn btn-outline-primary btn-lg" href="{{ path('app_index') }}">Ouvrir mon espace</a>
          {% else %}
            <a class="btn btn-primary btn-lg" href="{{ path('app_register') }}">Créer mon compte patient</a>
            <a class="btn btn-outline-primary btn-lg" href="{{ path('app_login') }}">Se connecter</a>
          {% endif %}
        </div>
        <ul class="hero-trust list-unstyled d-flex flex-wrap gap-4 mt-4 mb-0">
          <li><i class="bi bi-check-circle-fill" aria-hidden="true"></i> Accès par rôle</li>
          <li><i class="bi bi-check-circle-fill" aria-hidden="true"></i> Données confidentielles</li>
          <li><i class="bi bi-check-circle-fill" aria-hidden="true"></i> Interface responsive</li>
        </ul>
      </div>
      <div class="col-lg-6">
        <div class="hero-media">
          <img src="{{ asset('assets/img/carousel-1.jpg') }}" alt="Équipe soignante dans une clinique moderne" class="img-fluid">
          <div class="hero-stat" aria-label="Statistiques actuelles">
            <strong>{{ doctor_count }}</strong>
            <span>{{ doctor_count > 1 ? 'médecins disponibles' : 'médecin disponible' }}</span>
          </div>
        </div>
      </div>
    </div>
  </div>
</section>

<section id="services" class="section-space bg-white">
  <div class="container">
    <div class="section-heading text-center mx-auto">
      <span class="eyebrow">Services essentiels</span>
      <h2>Un parcours simple, sans informations inutiles</h2>
      <p>Chaque utilisateur accède uniquement aux actions et données nécessaires à sa mission.</p>
    </div>
    <div class="row g-4 mt-2">
      <div class="col-md-6 col-xl-3"><article class="service-card h-100"><i class="bi bi-calendar2-check" aria-hidden="true"></i><h3>Rendez-vous</h3><p>Demande, confirmation et suivi des rendez-vous avec prévention des conflits horaires.</p></article></div>
      <div class="col-md-6 col-xl-3"><article class="service-card h-100"><i class="bi bi-clock-history" aria-hidden="true"></i><h3>Disponibilités</h3><p>Des créneaux cohérents avec le planning réel des médecins.</p></article></div>
      <div class="col-md-6 col-xl-3"><article class="service-card h-100"><i class="bi bi-file-medical" aria-hidden="true"></i><h3>Suivi médical</h3><p>Consultations et prescriptions visibles seulement par les personnes autorisées.</p></article></div>
      <div class="col-md-6 col-xl-3"><article class="service-card h-100"><i class="bi bi-chat-left-text" aria-hidden="true"></i><h3>Accueil</h3><p>Un canal clair pour transmettre une réclamation ou une demande administrative.</p></article></div>
    </div>
  </div>
</section>

<section class="section-space process-section">
  <div class="container">
    <div class="row align-items-center g-4 g-lg-5">
      <div class="col-lg-5">
        <span class="eyebrow">Comment ça marche</span>
        <h2 class="mt-3">Trois étapes pour votre prochain rendez-vous</h2>
        <p class="text-muted">Les contrôles métier sont appliqués côté serveur : créneau futur, disponibilité du médecin et absence de chevauchement.</p>
      </div>
      <div class="col-lg-7">
        <ol class="process-list list-unstyled mb-0">
          <li><span>1</span><div><h3>Créez votre espace</h3><p>Utilisez uniquement des informations nécessaires à votre prise en charge.</p></div></li>
          <li><span>2</span><div><h3>Choisissez un créneau</h3><p>Sélectionnez un médecin disponible et le motif de la consultation.</p></div></li>
          <li><span>3</span><div><h3>Suivez votre demande</h3><p>Consultez le statut et retrouvez ensuite votre dossier médical autorisé.</p></div></li>
        </ol>
      </div>
    </div>
  </div>
</section>

<section class="section-space bg-white">
  <div class="container">
    <div class="d-flex flex-wrap justify-content-between align-items-end gap-3 mb-4">
      <div><span class="eyebrow">Vie de la clinique</span><h2 class="mt-2 mb-0">Prochains événements</h2></div>
      <a class="btn btn-outline-primary" href="{{ path('app_evenement_index') }}">Voir les {{ upcoming_event_count }} événements à venir</a>
    </div>
    <div class="row g-4">
      {% for event in upcoming_events %}
        <div class="col-md-6 col-xl-4">
          <article class="event-card h-100">
            <img src="{{ event.image ? asset('images/' ~ event.image) : asset('images/default-event.svg') }}" alt="Illustration de {{ event.titre }}">
            <div class="p-4"><div class="d-flex justify-content-between gap-3"><span class="badge text-bg-light">{{ event.category }}</span><time datetime="{{ event.date|date('Y-m-d') }}">{{ event.date|date('d/m/Y') }}</time></div><h3 class="mt-3">{{ event.titre }}</h3><p>{{ event.description }}</p><a href="{{ path('app_evenement_show', {id: event.id}) }}">Voir les détails <span aria-hidden="true">→</span></a></div>
          </article>
        </div>
      {% else %}
        <div class="col-12"><div class="empty-state-public"><i class="bi bi-calendar2" aria-hidden="true"></i><p class="mb-0">Aucun événement n’est programmé pour le moment.</p></div></div>
      {% endfor %}
    </div>
  </div>
</section>

<section class="privacy-section">
  <div class="container py-5"><div class="row align-items-center g-4"><div class="col-lg-8"><span class="eyebrow eyebrow-light">Confidentialité par conception</span><h2 class="text-white mt-2">Vos informations de santé ne sont pas un tableau administratif.</h2><p class="mb-0">Les dossiers médicaux restent accessibles au patient concerné et au médecin assigné. La réception et l’administration n’accèdent pas aux notes cliniques.</p></div><div class="col-lg-4 text-lg-end"><a class="btn btn-light btn-lg" href="{{ path('app_register') }}">Commencer en toute sécurité</a></div></div></div>
</section>
{% endblock %}
