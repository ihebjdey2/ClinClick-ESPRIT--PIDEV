{% extends 'base.html.twig' %}
{% block title %}Répondre à la réclamation | CliniClic{% endblock %}
{% block body %}<main id="main" class="main"><div class="pagetitle"><h1>Répondre à la réclamation</h1><p class="text-muted mb-0">Demande de {{ reclamation.nom }} · {{ reclamation.categorieReclamation }}</p></div><section class="section"><div class="row g-4"><div class="col-lg-5"><div class="card h-100"><div class="card-body pt-4"><h2 class="h5">Demande reçue</h2><p class="text-muted small">{{ reclamation.email }}</p><p class="text-pre-wrap mb-0">{{ reclamation.description }}</p></div></div></div><div class="col-lg-7"><div class="card"><div class="card-body pt-4">{{ form_start(f) }}{{ form_errors(f) }}{{ form_row(f.objet) }}{{ form_row(f.message) }}<div class="d-flex flex-wrap gap-2 mt-4"><button class="btn btn-primary" type="submit">Enregistrer la réponse</button><a class="btn btn-outline-secondary" href="{{ path('app_reclamation') }}">Annuler</a></div>{{ form_end(f) }}</div></div></div></div></section></main>{% endblock %}
