{{ form_start(form) }}
  {{ form_errors(form) }}
  <div class="row g-3">
    <div class="col-md-5">{{ form_row(form.consultedAt) }}</div>
    <div class="col-12">{{ form_row(form.diagnosis) }}</div>
    <div class="col-12">{{ form_row(form.clinicalNotes) }}</div>
  </div>
  <div class="d-flex flex-wrap gap-2 mt-4">
    <button class="btn btn-primary" type="submit">{{ button_label|default('Enregistrer') }}</button>
    <a class="btn btn-outline-secondary" href="{{ consultation.id ? path('app_consultation_show', {id: consultation.id}) : path('app_RDV_index') }}">Annuler</a>
  </div>
{{ form_end(form) }}
