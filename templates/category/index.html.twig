{% extends 'base.html.twig' %}
{% block title %}Catégories d’événements | CliniClic{% endblock %}
{% block body %}<main id="main" class="main"><div class="pagetitle d-flex flex-wrap justify-content-between align-items-center gap-3"><div><h1>Catégories d’événements</h1><p class="text-muted mb-0">Organisez les publications visibles sur le site public.</p></div><a class="btn btn-primary" href="{{ path('app_category_new') }}"><i class="bi bi-plus-lg me-1" aria-hidden="true"></i> Ajouter</a></div>{{ include('components/_flash.html.twig') }}<section class="section"><div class="card"><div class="card-body pt-3"><div class="table-responsive"><table class="table table-hover align-middle mb-0"><thead><tr><th>Nom</th><th>Description</th><th>Événements liés</th><th class="text-end">Actions</th></tr></thead><tbody>{% for category in categories %}<tr><td><strong>{{ category.nom }}</strong></td><td>{{ category.libelle }}</td><td>{{ category.evenements|length }}</td><td class="text-end"><div class="d-inline-flex flex-wrap gap-2"><a class="btn btn-sm btn-outline-secondary" href="{{ path('app_category_show', {id: category.id}) }}">Voir</a><a class="btn btn-sm btn-outline-primary" href="{{ path('app_category_edit', {id: category.id}) }}">Modifier</a></div></td></tr>{% else %}<tr><td colspan="4" class="text-center text-muted py-5">Aucune catégorie enregistrée.</td></tr>{% endfor %}</tbody></table></div></div></div></section></main>{% endblock %}
