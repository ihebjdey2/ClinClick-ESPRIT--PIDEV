{% extends 'base.html.twig' %}
{% block title %}{{ category.nom }} | CliniClic{% endblock %}
{% block body %}<main id="main" class="main"><div class="pagetitle"><h1>{{ category.nom }}</h1><p class="text-muted mb-0">Catégorie d’événement</p></div><section class="section"><div class="row justify-content-center"><div class="col-lg-8"><div class="card"><div class="card-body pt-4"><dl class="row"><dt class="col-sm-4">Nom</dt><dd class="col-sm-8">{{ category.nom }}</dd><dt class="col-sm-4">Description</dt><dd class="col-sm-8">{{ category.libelle }}</dd><dt class="col-sm-4">Événements liés</dt><dd class="col-sm-8">{{ category.evenements|length }}</dd></dl><div class="d-flex flex-wrap gap-2"><a class="btn btn-primary" href="{{ path('app_category_edit', {id: category.id}) }}">Modifier</a>{{ include('category/_delete_form.html.twig') }}<a class="btn btn-outline-secondary" href="{{ path('app_category_index') }}">Retour</a></div></div></div></div></div></section></main>{% endblock %}
