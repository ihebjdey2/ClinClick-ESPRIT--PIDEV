<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.text.Font?>

<AnchorPane id="AnchorPane" prefHeight="730.0" prefWidth="1059.0" xmlns="http://javafx.com/javafx/8.0.171" xmlns:fx="http://javafx.com/fxml/1" fx:controller="GUI.CategorieInterfaceController">
   <children>
      <Button layoutX="441.0" layoutY="263.0" mnemonicParsing="false" onAction="#Ajoutercategorie" prefHeight="31.0" prefWidth="89.0" style="-fx-background-color: #048B9A; radius: 40;" text="Ajouter">
         <font>
            <Font name="System Bold" size="14.0" />
         </font></Button>
      <TextField fx:id="inputNom" layoutX="262.0" layoutY="223.0" />
      <TableView fx:id="tableCategorie" layoutX="185.0" layoutY="301.0" prefHeight="237.0" prefWidth="547.0">
        <columns>
          <TableColumn fx:id="idt" prefWidth="75.0" text="id" />
          <TableColumn fx:id="nomT" onEditCommit="#Change_Nom" prefWidth="219.0" text="Nom" />
            <TableColumn fx:id="libelleT" onEditCommit="#Change_Libelle" prefWidth="252.0" text="Libelle" />
        </columns>
      </TableView>
      <Button layoutX="558.0" layoutY="263.0" mnemonicParsing="false" onAction="#Supprimer" prefHeight="31.0" prefWidth="89.0" style="-fx-background-color: #048B9A; radius: 20;" text="Supprimer">
         <font>
            <Font name="System Bold" size="13.0" />
         </font></Button>
      <Label layoutX="185.0" layoutY="219.0" prefHeight="33.0" prefWidth="77.0" text="Nom :">
         <font>
            <Font name="System Bold Italic" size="14.0" />
         </font></Label>
      <TextField fx:id="inputLibelle" layoutX="262.0" layoutY="266.0" />
      <Label layoutX="185.0" layoutY="262.0" prefHeight="33.0" prefWidth="77.0" text="Libelle :">
         <font>
            <Font name="System Bold Italic" size="14.0" />
         </font></Label>
   </children>
</AnchorPane>
