<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Hyperlink?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.image.Image?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>

<BorderPane maxHeight="-Infinity" maxWidth="-Infinity" minHeight="-Infinity" minWidth="-Infinity" prefHeight="600.0" prefWidth="929.0" xmlns="http://javafx.com/javafx/19" xmlns:fx="http://javafx.com/fxml/1" fx:controller="GUI.AfficheAdminController">
    <top>
        <HBox alignment="CENTER_LEFT" spacing="20.0" style="-fx-background-color: #343a40;">
            <ImageView fitHeight="50.0" fitWidth="50.0" pickOnBounds="true" preserveRatio="true">
                <image>
                    <Image url="@../../../../../rare.jfif" />
                </image>
            </ImageView>
            <TextField fx:id="eChercher" promptText="Rechercher" style="-fx-background-color: white;" />
            <Region HBox.hgrow="ALWAYS" />
         <Button mnemonicParsing="false" onAction="#stock" style="-fx-background-color: #007bff;" text="gerer les stocks" textFill="WHITE" />
         <Button mnemonicParsing="false" onAction="#afficher_evnt" style="-fx-background-color: #007bff;" text="gerer les evenement" textFill="WHITE" />
         <Button mnemonicParsing="false" onAction="#afficherRec" style="-fx-background-color: #007bff;" text="repondre une reclamation" textFill="WHITE" />
            <Button style="-fx-background-color: #007bff; -fx-text-fill: white;" text="Déconnexion" />
        </HBox>
    </top>
    <center>
        <VBox alignment="CENTER" prefHeight="504.0" prefWidth="700.0" spacing="20.0">
            <Label style="-fx-font-size: 24pt;" text="Liste des utilisateurs" />
            <TableView fx:id="userTable" prefHeight="331.0" prefWidth="929.0" style="-fx-font-size: 14pt;">
                
                <columns>
                    <TableColumn fx:id="idColumn" prefWidth="98.0" text="Id" />
                    <TableColumn fx:id="nomColumn" prefWidth="200.0" text="Nom" />
                    <TableColumn fx:id="prenomColumn" prefWidth="210.0" text="Prenom" />
                    <TableColumn fx:id="emailColumn" prefWidth="264.0" text="Adresse email" />
                    <TableColumn fx:id="roleColumn" prefWidth="120.0" text="Rôle" />
                    <TableColumn fx:id="genreColumn" prefWidth="98.0" text="genre" />
                    <TableColumn fx:id="passwordColumn" prefWidth="98.0" text="Password" />
                    <TableColumn fx:id="date_naissanceColumn" prefWidth="98.0" text="Date_naissance" />
                    <TableColumn fx:id="is_verifiedColumn" prefWidth="98.0" text="Is_verified" />
                </columns>
            </TableView>
            <HBox alignment="CENTER" spacing="20.0">
                <Button fx:id="addButton" onAction="#handleAdd" onMouseClicked="#handleAdd" style="-fx-background-color: #007bff; -fx-text-fill: white;" text="Ajouter" />
                <Button fx:id="editButton" onAction="#handleEdit" style="-fx-background-color: #007bff; -fx-text-fill: white;" text="Modifier" />
                <Button fx:id="deleteButton" onAction="#handleDelete" style="-fx-background-color: #007bff; -fx-text-fill: white;" text="Supprimer" />
            <Button onMouseClicked="#exporterToXlxs" style="-fx-background-color: #007bff; -fx-text-fill: white;" text="Save liste" fx:id="xl" />
            <Button fx:id="pdf" onAction="#ExporterListe" onMouseClicked="#exporterToXlxs" style="-fx-background-color: #007bff; -fx-text-fill: white;" text="pdf" />
            </HBox>
        </VBox>
    </center>
    <bottom>
        <HBox alignment="CENTER" spacing="20.0" style="-fx-background-color: #343a40;">
            <Label style="-fx-text-fill: white;" text="© 2023 - Tous droits réservés" />
            <Hyperlink style="-fx-text-fill: white;" text="Politique de confidentialité" />
            <Hyperlink style="-fx-text-fill: white;" text="Conditions d'utilisation" />
        </HBox>
    </bottom>
</BorderPane>
